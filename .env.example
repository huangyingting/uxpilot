# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example Production PostgreSQL URL:
# DATABASE_URL="postgresql://uxpilot:uxpilot_secret@localhost:5432/uxpilot?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="uxpilot-super-secret-nextauth-jwt-key-2026"

# Pluggable AI Capability Configuration
# Supported values: "copilot-sdk" (default) | "azure-openai" | "deterministic"
AI_PROVIDER="copilot-sdk"
AI_COPILOT_MODEL="gpt-4.1"

# Azure OpenAI Configuration (used when AI_PROVIDER="azure-openai")
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-10-21"

# CLI-Only Admin Bootstrap Defaults (used by `npm run bootstrap:admin`)
BOOTSTRAP_ADMIN_EMAIL="admin@uxpilot.local"
BOOTSTRAP_ADMIN_NAME="Alex Rivera"
BOOTSTRAP_ADMIN_PASSWORD="AdminPassword123!"
